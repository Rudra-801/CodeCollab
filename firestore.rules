rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function own(uid) { return request.auth != null && request.auth.uid == uid; }
  function member(k,id) { return request.auth != null && exists(/databases/$(database)/documents/$(k)/$(id)/members/$(request.auth.uid)); }
  function edit(p) { return member('projects',p) && get(/databases/$(database)/documents/projects/$(p)/members/$(request.auth.uid)).data.role in ['owner','admin','editor'] && !get(/databases/$(database)/documents/projects/$(p)).data.archived; }
  function newPersonalProject(id) {
   let p = /databases/$(database)/documents/projects/$(id);
   return request.auth != null && !exists(p)
    && !exists(/databases/$(database)/documents/accountClosures/$(request.auth.uid))
    && getAfter(p).data.owner == request.auth.uid;
  }

  function projectAdmin(p) { return member('projects',p) && get(/databases/$(database)/documents/projects/$(p)/members/$(request.auth.uid)).data.role in ['owner','admin']; }
  function redeemedInvite(p,uid,role,inviteId) {
   let invite = /databases/$(database)/documents/projectInvitations/$(inviteId);
   return request.auth != null && request.auth.uid==uid && !exists(/databases/$(database)/documents/accountClosures/$(uid))
    && get(invite).data.project==p && get(invite).data.role==role && !get(invite).data.revoked
    && get(invite).data.usedBy=='' && get(invite).data.expiresAt>request.time
    && getAfter(invite).data.usedBy==uid && getAfter(invite).data.redeemedAt==request.time;
  }

  function projectOwner(p) { return request.auth!=null && get(/databases/$(database)/documents/projects/$(p)).data.owner==request.auth.uid; }
  function removalAudit(p,uid) {
   let member = get(/databases/$(database)/documents/projects/$(p)/members/$(uid));
   return getAfter(/databases/$(database)/documents/projects/$(p)/activity/$('removed_'+uid+'_'+member.data.get('invitation','legacy'))).data=={'action':'remove','uid':request.auth.uid,'target':uid,'createdAt':request.time};
  }
  match /projects/{p}/members/{uid} {
   allow update: if projectOwner(p) && resource.data.role!='owner'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','audit'])
    && request.resource.data.role in ['admin','editor','viewer']
    && getAfter(/databases/$(database)/documents/projects/$(p)/activity/$(request.resource.data.audit)).data=={'action':'role','uid':request.auth.uid,'target':uid,'role':request.resource.data.role,'createdAt':request.time}
    && getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(p)).data.role==request.resource.data.role;
   allow delete: if projectOwner(p) && resource.data.role!='owner'
    && !existsAfter(/databases/$(database)/documents/users/$(uid)/projects/$(p)) && removalAudit(p,uid);
  }
  match /users/{uid}/projects/{p} {
   allow update: if projectOwner(p) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
    && getAfter(/databases/$(database)/documents/projects/$(p)/members/$(uid)).data.role==request.resource.data.role;
   allow delete: if projectOwner(p) && !existsAfter(/databases/$(database)/documents/projects/$(p)/members/$(uid)) && removalAudit(p,uid);
  }
  match /projects/{p}/activity/{event} {
   allow create: if projectOwner(p) && request.resource.data.uid==request.auth.uid && request.resource.data.createdAt==request.time
    && (request.resource.data.action=='role' && request.resource.data.keys().hasOnly(['action','uid','target','role','createdAt'])
     && getAfter(/databases/$(database)/documents/projects/$(p)/members/$(request.resource.data.target)).data.audit==event)
     || (projectOwner(p) && request.resource.data.action=='remove'
      && request.resource.data.keys().hasOnly(['action','uid','target','createdAt'])
      && request.resource.data.uid==request.auth.uid && request.resource.data.createdAt==request.time
      && exists(/databases/$(database)/documents/projects/$(p)/members/$(request.resource.data.target))
      && !existsAfter(/databases/$(database)/documents/projects/$(p)/members/$(request.resource.data.target))
      && event=='removed_'+request.resource.data.target+'_'+get(/databases/$(database)/documents/projects/$(p)/members/$(request.resource.data.target)).data.get('invitation','legacy'));
  }
  match /projectInvitations/{token} {
   allow get: if request.auth != null;
   allow list: if false;
   allow create: if request.resource.data.keys().hasOnly(['project','role','createdBy','createdAt','expiresAt','revoked','usedBy'])
    && projectAdmin(request.resource.data.project) && request.resource.data.role in ['editor','viewer']
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time
    && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt>request.time
    && request.resource.data.expiresAt<=request.time+duration.value(7,'d')
    && request.resource.data.revoked==false && request.resource.data.usedBy=='';
   allow update: if
    (projectAdmin(resource.data.project) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked==true)
    || (request.auth!=null && resource.data.usedBy=='' && !resource.data.revoked && resource.data.expiresAt>request.time
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','redeemedAt'])
     && request.resource.data.usedBy==request.auth.uid && request.resource.data.redeemedAt==request.time
     && !exists(/databases/$(database)/documents/projects/$(resource.data.project)/members/$(request.auth.uid))
     && getAfter(/databases/$(database)/documents/projects/$(resource.data.project)/members/$(request.auth.uid)).data=={'uid':request.auth.uid,'role':resource.data.role,'invitation':token}
     && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(resource.data.project)).data=={'id':resource.data.project,'role':resource.data.role,'invitation':token});
  }
  match /projects/{p}/members/{uid} {
   allow create: if request.resource.data.keys().hasOnly(['uid','role','invitation'])
    && request.resource.data.uid==uid && redeemedInvite(p,uid,request.resource.data.role,request.resource.data.invitation);
  }
  match /users/{uid}/projects/{p} {
   allow create: if request.resource.data.keys().hasOnly(['id','role','invitation'])
    && request.resource.data.id==p && redeemedInvite(p,uid,request.resource.data.role,request.resource.data.invitation);
  }
  match /projects/{id} {
   allow create: if newPersonalProject(id)
    && request.resource.data.keys().hasOnly(['name','owner','archived','createdAt','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80
    && request.resource.data.archived==false && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time
    && getAfter(/databases/$(database)/documents/projects/$(id)/members/$(request.auth.uid)).data.role=='owner'
    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(id)).data.id==id
    && getAfter(/databases/$(database)/documents/projects/$(id)/activity/created).data.uid==request.auth.uid;
   match /members/{uid} { allow create: if own(uid) && newPersonalProject(id) && request.resource.data=={'uid':uid,'role':'owner'}; }
   match /activity/created { allow create: if newPersonalProject(id) && request.resource.data=={'uid':request.auth.uid,'action':'create','createdAt':request.time}; }
  }
  match /users/{uid}/projects/{id} { allow create: if own(uid) && newPersonalProject(id) && request.resource.data=={'id':id,'role':'owner'}; }
  match /users/{uid} {
   allow read: if own(uid);
   allow create,update: if own(uid) && request.resource.data.keys().hasOnly(['name','minimap','theme','notifications']) && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.minimap is bool && request.resource.data.notifications is bool && request.resource.data.theme in ['vs-dark','hc-black'];
   match /notifications/{n} { allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true; }
   match /{kind}/{id} { allow read: if own(uid) && kind in ['projects','teams','notifications']; }
  }
  match /{kind}/{id} {
   allow read: if kind in ['teams','projects'] && member(kind,id);
   match /{sub}/{entry} { allow read: if kind in ['teams','projects'] && sub in ['members','activity'] && member(kind,id); }
  }
  match /teams/{t}/projects/{id} { allow read: if member('teams',t); }
  match /projects/{p}/folders/{id} { allow read: if member('projects',p); }
  match /projects/{p}/files/{f} {
   allow read: if member('projects',p);
   function validName() { return request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=160; }
   allow create: if (newPersonalProject(p) || edit(p)) && !exists(/databases/$(database)/documents/projects/$(p)/deletedFiles/$(f)) && validName() && request.resource.data.keys().hasOnly(['name','createdAt','parent']) && (request.resource.data.get('parent','') == '' || exists(/databases/$(database)/documents/projects/$(p)/folders/$(request.resource.data.parent))) && request.resource.data.createdAt==request.time;
   allow update: if edit(p) && validName() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
   match /updates/{u} {
    allow read: if member('projects',p) && exists(/databases/$(database)/documents/projects/$(p)/files/$(f));
    allow create: if ((newPersonalProject(p) && getAfter(/databases/$(database)/documents/projects/$(p)/files/$(f)).data.createdAt == request.time) || (edit(p) && exists(/databases/$(database)/documents/projects/$(p)/files/$(f)))) && request.resource.data.keys().hasOnly(['bytes','uid','createdAt']) && own(request.resource.data.uid) && request.resource.data.createdAt==request.time && request.resource.data.bytes is bytes && request.resource.data.bytes.size()<=200000;
   }
  }
  match /projects/{p}/versions/{v} { allow read: if member('projects',p); }
  match /projects/{p}/messages/{m} {
   allow read: if member('projects',p);
   allow create: if member('projects',p) && own(request.resource.data.uid) && request.resource.data.keys().hasOnly(['uid','text','createdAt']) && request.resource.data.createdAt==request.time && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=2000;
  }
 }
}








